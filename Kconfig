menu "Logger ADC Module Options"
    config LOGGER_ADC_ENABLED
        bool "Enable logger_adc module"
        default y
        help
            Enable logger_adc module.
    if LOGGER_ADC_ENABLED
    choice 
        bool "ADC mode"
        default LOGGER_ADC_MODE_ONESHOT
        help
            Specify the ADC mode to use.
        config LOGGER_ADC_MODE_CONTINUOUS
            bool "Continuous mode"
        config LOGGER_ADC_MODE_ONESHOT
            bool "One-shot mode"
    endchoice
    config ADC_UNIT
        int "ADC unit (1 or 2)"
        range 1 2
        default 1
        help
            Specify the ADC unit to use.
    config ADC_CHANNEL
        int "ADC channel (0-9, see help)"
        range 0 9
        default 3 if IDF_TARGET_ESP32S3
        default 7
        help
            Specify the ADC channel to use (0-9).
            Esp32:
                ADC1_CHANNEL_0 = 0
                ADC1 channel 0 is GPIO36
                ADC1 channel 1 is GPIO37
                ADC1 channel 2 is GPIO38
                ADC1 channel 3 is GPIO39
                ADC1 channel 4 is GPIO32
                ADC1 channel 5 is GPIO33
                ADC1 channel 6 is GPIO34
                ADC1 channel 7 is GPIO35
                ADC2 channel 0 is GPIO4 (ESP32), GPIO11 (ESP32-S2)
                ADC2 channel 1 is GPIO0 (ESP32), GPIO12 (ESP32-S2)
                ADC2 channel 2 is GPIO2 (ESP32), GPIO13 (ESP32-S2)
                ADC2 channel 3 is GPIO15 (ESP32), GPIO14 (ESP32-S2)
                ADC2 channel 4 is GPIO13 (ESP32), GPIO15 (ESP32-S2)
                ADC2 channel 5 is GPIO12 (ESP32), GPIO16 (ESP32-S2)
                ADC2 channel 6 is GPIO14 (ESP32), GPIO17 (ESP32-S2)
                ADC2 channel 7 is GPIO27 (ESP32), GPIO18 (ESP32-S2)
                ADC2 channel 8 is GPIO25 (ESP32), GPIO19 (ESP32-S2)
                ADC2 channel 9 is GPIO26 (ESP32), GPIO20 (ESP32-S2)
            Esp32-S3:
                ADC1 channel 0 is GPIO1
                ADC1 channel 1 is GPIO2
                ADC1 channel 2 is GPIO3
                ADC1 channel 3 is GPIO4
                ADC1 channel 4 is GPIO5
                ADC1 channel 5 is GPIO6
                ADC1 channel 6 is GPIO7
                ADC1 channel 7 is GPIO8
                ADC1 channel 8 is GPIO9
                ADC1 channel 9 is GPIO10
                ADC2 channel 0 is GPIO4 (ESP32), GPIO11 (ESP32-S2)
                ADC2 channel 1 is GPIO0 (ESP32), GPIO12 (ESP32-S2)
                ADC2 channel 2 is GPIO2 (ESP32), GPIO13 (ESP32-S2)
                ADC2 channel 3 is GPIO15 (ESP32), GPIO14 (ESP32-S2)
                ADC2 channel 4 is GPIO13 (ESP32), GPIO15 (ESP32-S2)
                ADC2 channel 5 is GPIO12 (ESP32), GPIO16 (ESP32-S2)
                ADC2 channel 6 is GPIO14 (ESP32), GPIO17 (ESP32-S2)
                ADC2 channel 7 is GPIO27 (ESP32), GPIO18 (ESP32-S2)
                ADC2 channel 8 is GPIO25 (ESP32), GPIO19 (ESP32-S2)
                ADC2 channel 9 is GPIO26 (ESP32), GPIO20 (ESP32-S2)
    config ADC_ATTEN
        int "ADC attenuation ([0 25 6 12]db, see help)"
        range 0 12
        default 12
        help
            In order to convert voltages larger than Vref, input voltages can be
            attenuated before being input to the ADCs. There are 4 available 
            attenuation options, the higher the attenuation is, the higher the 
            measurable input voltage could be.
            - ADC_ATTEN_DB_0 No input attenuation, ADC can measure up to approx.
            - ADC_ATTEN_DB_2_5 The input voltage of ADC will be attenuated extending 
                the range of measurement by about 2.5 dB.
            - ADC_ATTEN_DB_6 The input voltage of ADC will be attenuated extending 
                the range of measurement by about 6 dB.
            - ADC_ATTEN_DB_12 The input voltage of ADC will be attenuated extending 
                the range of measurement by about 12 dB.
    config ADC_BITWIDTH
        int "ADC bit width (1-13 bits, 0 for default)"
        range 0 13
        default 12
        help
            The ADC bit width can be set to 0 (default) or 9-13(bits). 
            The higher the bit width is, the higher the resolution of the ADC will be.
    choice
        bool "Default log verbosity"
        default LOGGER_ADC_LOG_LEVEL_ERROR
        help
            Specify how important log should be added.
        config LOGGER_ADC_LOG_LEVEL_TRACE
            bool "TRACE: A lot of logs to give detailed information"
        config LOGGER_ADC_LOG_LEVEL_INFO
            bool "INFO: Log important events"
        config LOGGER_ADC_LOG_LEVEL_WARN
            bool "WARN: Log if something unwanted happened but didn't cause a problem"
        config LOGGER_ADC_LOG_LEVEL_ERROR
            bool "ERROR: Only critical issues, when the system may fail"
        config LOGGER_ADC_LOG_LEVEL_USER
            bool "USER: Only logs added by the user"
        config LOGGER_ADC_LOG_LEVEL_NONE
            bool "NONE: Do not log anything"
    endchoice
    config LOGGER_ADC_LOG_LEVEL
        int
        default 0 if LOGGER_ADC_LOG_LEVEL_TRACE
        default 1 if LOGGER_ADC_LOG_LEVEL_INFO
        default 2 if LOGGER_ADC_LOG_LEVEL_WARN
        default 3 if LOGGER_ADC_LOG_LEVEL_ERROR
        default 4 if LOGGER_ADC_LOG_LEVEL_USER
        default 5 if LOGGER_ADC_LOG_LEVEL_NONE

    menu "ULP Sensor Monitoring"
        config ULP_BUTTON_ENABLED
            bool "Enable ULP button monitoring"
            default y
            help
                Enable ULP coprocessor button long press monitoring.
                
                IMPORTANT: When enabled, ensure ULP_BUTTON_GPIO matches 
                LOGGER_BUTTON_GPIO_0 to monitor the same physical button.
                
        config ULP_BUTTON_GPIO
            int "Button GPIO number"
            depends on ULP_BUTTON_ENABLED
            range 0 39
            default 39
            help
                GPIO number for the button (must be RTC GPIO).
                NOTE: This should match LOGGER_BUTTON_GPIO_0 in logger_button module
                to monitor the same physical button.
                
        config ULP_BUTTON_RTC_IO
            int "Button RTC IO number"
            depends on ULP_BUTTON_ENABLED  
            range 0 17
            default 3 if ULP_BUTTON_GPIO = 39
            default 11 if ULP_BUTTON_GPIO = 0
            default 12 if ULP_BUTTON_GPIO = 2
            default 10 if ULP_BUTTON_GPIO = 4
            default 15 if ULP_BUTTON_GPIO = 12
            default 14 if ULP_BUTTON_GPIO = 13
            default 16 if ULP_BUTTON_GPIO = 14
            default 13 if ULP_BUTTON_GPIO = 15
            default 6 if ULP_BUTTON_GPIO = 25
            default 7 if ULP_BUTTON_GPIO = 26
            default 17 if ULP_BUTTON_GPIO = 27
            default 9 if ULP_BUTTON_GPIO = 32
            default 8 if ULP_BUTTON_GPIO = 33
            default 4 if ULP_BUTTON_GPIO = 34
            default 5 if ULP_BUTTON_GPIO = 35
            default 0 if ULP_BUTTON_GPIO = 36
            default 1 if ULP_BUTTON_GPIO = 37
            default 2 if ULP_BUTTON_GPIO = 38
            default 3
            help
                RTC IO number corresponding to the button GPIO.
                This is automatically calculated based on ULP_BUTTON_GPIO.
                ESP32 GPIO to RTC_IO mapping:
                GPIO0→RTC_IO11, GPIO2→RTC_IO12, GPIO4→RTC_IO10,
                GPIO12→RTC_IO15, GPIO13→RTC_IO14, GPIO14→RTC_IO16,
                GPIO15→RTC_IO13, GPIO25→RTC_IO6, GPIO26→RTC_IO7,
                GPIO27→RTC_IO17, GPIO32→RTC_IO9, GPIO33→RTC_IO8,
                GPIO34→RTC_IO4, GPIO35→RTC_IO5, GPIO36→RTC_IO0,
                GPIO37→RTC_IO1, GPIO38→RTC_IO2, GPIO39→RTC_IO3
                
        config ULP_BUTTON_LONG_PRESS_MS
            int "Long press duration (milliseconds)"
            depends on ULP_BUTTON_ENABLED
            range 1000 10000
            default 3000
            help
                Duration in milliseconds for long press detection.
                
        config ULP_CYCLE_TIME_MS
            int "ULP cycle time (milliseconds)"
            range 50 1000
            default 125
            help
                Time between ULP wake cycles in milliseconds.
                Affects button responsiveness and power consumption.
    endmenu
    endif
endmenu
